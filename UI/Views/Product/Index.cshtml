@model ListModel<Product>

<!DOCTYPE html>

<html lang="en">

<head>
    <meta name="viewport" content="width=device-width" />
    <title>ProductList</title>
</head>

<body>

    <h1>Products</h1>
    <div class="col-2 border-2">
        <ul class="nav ">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button"
                   aria-expanded="false">Services</a>
                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" asp-controller="Product" asp-route-service=@null>All</a>
                    </li>
                    @foreach (var item in ViewBag.Services)
                    {
                        <li>
                            <a class="dropdown-item" asp-controller="Product" asp-route-service="@item.NormalizedName">
                                @item.Name
                            </a>
                        </li>
                    }
                </ul>
            </li>
        </ul>
    </div>

    <div id="product-list">
        <partial name="_ListPartial" model="Model" />
    </div>

</body>

</html>
